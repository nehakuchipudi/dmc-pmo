# Local development environment variables for the DMC PMO monorepo.
# Copy to .env and adjust as needed. Do not commit real secrets.

# PostgreSQL OLTP connection used by apps/api (Prisma).
DATABASE_URL="postgresql://dmc:dmc@127.0.0.1:5432/dmc_pmo?schema=public"

# Port the NestJS API listens on.
API_PORT=4000

# Base URL the Next.js web app uses to reach the API (server side).
API_URL="http://127.0.0.1:4000"

# Port the Next.js web app listens on.
WEB_PORT=3000
