# Microsoft Entra ID (SPA + PKCE). Leave empty to use email directory + demo users.
NEXT_PUBLIC_ENTRA_CLIENT_ID=
# Use "common" so work and personal Microsoft emails can sign up.
NEXT_PUBLIC_ENTRA_TENANT_ID=common
# Optional CIAM authority, e.g. https://yourtenant.ciamlogin.com/your-tenant-id
NEXT_PUBLIC_ENTRA_AUTHORITY=
# Optional override. Default is {origin}/auth/callback/
NEXT_PUBLIC_ENTRA_REDIRECT_URI=
