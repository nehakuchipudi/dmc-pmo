// DMC PMO operational (OLTP) schema, Phase 0 slice.
// The full operational domain is described in docs/PRODUCT_MASTER_PLAN.md (section 10).
// This slice models Companies and Contacts so the web app has an end-to-end flow.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  PROSPECT
  ON_HOLD
  ARCHIVED
}

model Company {
  id             String        @id @default(uuid())
  name           String
  status         CompanyStatus @default(ACTIVE)
  accountManager String?       @map("account_manager")
  website        String?
  notes          String?
  openProjects   Int           @default(0) @map("open_projects")
  openTickets    Int           @default(0) @map("open_tickets")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  contacts Contact[]

  @@map("companies")
}

model Contact {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String?
  portalAccess Boolean  @default(false) @map("portal_access")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("contacts")
}
